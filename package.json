{
  "name": "retail-ops",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @retail-ops/domain -w @retail-ops/db -w @retail-ops/api -w @retail-ops/web",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w @retail-ops/db",
    "dev:api": "npm run dev -w @retail-ops/api",
    "dev:web": "npm run dev -w @retail-ops/web",
    "lint": "tsc -b --noEmit",
    "db:down": "docker compose down",
    "db:seed": "npm run seed -w @retail-ops/db",
    "db:status": "npm run status -w @retail-ops/db",
    "db:reset": "npm run reset -w @retail-ops/db"
  },
  "devDependencies": {
    "vitest": "5.0.0",
    "tsx": "4.23.13"
  },
  "dependencies": {
    "@retail-ops/api": "*",
    "@retail-ops/db": "*",
    "@retail-ops/domain": "*",
    "typescript": "5.9.3",
    "@types/node": "22.20.1"
  }
}
