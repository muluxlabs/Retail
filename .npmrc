# Build tooling (typescript, vite) lives in devDependencies. Vercel applies
# project environment variables to `npm install`, so a stray NODE_ENV=production
# would omit them and the build would fail with "tsc: command not found".
# This makes the install immune to that regardless of the install command used.
include=dev

# Reproducible installs; never silently reach for a different version.
save-exact=true
