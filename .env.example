# Copy to .env — never commit the real file.
NODE_ENV=development
API_PORT=3000

# Postgres. docker-compose.yml provisions this locally on a non-default port
# (5433) so it never collides with another local Postgres or another
# project's container. Override the port with DB_PORT if needed.
# Replace user/password/host/db below with your own — nothing here is a
# real credential.
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>

# Session signing. Generate with: openssl rand -hex 32
# Required in production: it signs the session cookie. Never reuse a value
# from this file — always generate your own.
SESSION_SECRET=

# Password for the seeded administrator account. Only read by `db:seed`.
# Leave unset to have one generated and printed once (recommended).
ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
