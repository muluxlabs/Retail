# Copy to .env — never commit the real file.
NODE_ENV=development
API_PORT=3000

# Postgres. docker-compose.yml provisions this locally.
# Host port is 5433, not 5432, so it never collides with another local
# Postgres or another project's container. Override with DB_PORT.
DATABASE_URL=postgres://retail:retail@localhost:5433/retail_ops

# Session signing. Generate with: openssl rand -hex 32
# Must be a real secret in production: it signs the session cookie.
SESSION_SECRET=change-me

# Password for the seeded administrator account. Only read by `db:seed`.
# Leave unset to have one generated and printed once.
ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
